projection;
strict ( 2 );
use draft;
define behavior for ZMS_C_LEAVE_REQ //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use association _ITEM { create; with draft; }

  use action Resume;
  use action Activate;
  use action Edit;
  use action Discard;
  use action Prepare;

}

define behavior for ZMS_C_LEAVE_REQ_I //alias <alias_name>
{
  use update;
  use delete;

  use association _HDR { with draft; }
}